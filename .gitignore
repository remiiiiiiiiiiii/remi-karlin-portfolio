# Full-quality videos are too large for git (11 GB).
# Only the small preview clips (*-preview.mp4) are committed.
# Full films of 40 s or less live tracked under public/videos/full/ (12 MB each at most); longer films go on YouTube.
public/videos/*.mp4
public/videos/*.mov
!public/videos/*-preview.mp4

# Source PDFs for process pages (converted to slides already)
public/images/*.pdf

# Local Claude Code permissions, per machine
.claude/settings.local.json

# Untracked local tooling folders
stop-slop/
.impeccable/

# pick-frames candidate stills (scripts/pick-frames.mjs)
.frames/
